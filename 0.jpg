   "source": [
    "def form_row(parent, label, var, placeholder=\"\"):\n",
    "    row = tk.Frame(parent, bg=CARD)\n",
    "    row.pack(fill=\"x\", padx=18, pady=3)\n",
    "    tk.Label(row, text=label, font=F_LABEL, bg=CARD,\n",
    "             fg=MUTED, width=14, anchor=\"w\").pack(side=\"left\")\n",
    "    e = tk.Entry(row, textvariable=var, font=F_ENTRY,\n",
    "                 bg=ENTRY_BG, fg=TEXT, insertbackground=ACCENT,\n",
    "                 relief=\"flat\", bd=6, highlightthickness=1,\n",
    "                 highlightbackground=BORDER, highlightcolor=ACCENT)\n",
    "    e.pack(side=\"left\", fill=\"x\", expand=True)\n",
    "    return e"
   ]
  },
  {
