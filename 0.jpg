   "source": [
    "BG        = \"#080c14\"   # Near-black\n",
    "PANEL     = \"#0e1420\"   # Dark panel\n",
    "CARD      = \"#111827\"   # Card background\n",
    "BORDER    = \"#1e2d40\"   # Subtle border\n",
    "ACCENT    = \"#00c8ff\"   # Cyan accent\n",
    "ACCENT2   = \"#00ff9d\"   # Neon green\n",
    "WARN      = \"#ff6b35\"   # Orange warning\n",
    "DANGER    = \"#ff3b5c\"   # Red danger\n",
    "TEXT      = \"#e8f4f8\"   # Primary text\n",
    "MUTED     = \"#4a6b80\"   # Muted text\n",
    "ENTRY_BG  = \"#0a1828\"   # Entry fields\n",
    "SEL       = \"#003d52\"   # Selection\n",
    "\n",
    "# ── Fonts ──────────────────────────────────────────────────────────────────────\n",
    "F_TITLE  = (\"Courier New\", 20, \"bold\")\n",
    "F_HEAD   = (\"Courier New\", 13, \"bold\")\n",
    "F_LABEL  = (\"Courier New\", 10)\n",
    "F_ENTRY  = (\"Courier New\", 11)\n",
    "F_BTN    = (\"Courier New\", 10, \"bold\")\n",
    "F_STATUS = (\"Courier New\", 9)\n",
    "F_TABLE  = (\"Courier New\", 10)\n",
    "F_MONO   = (\"Courier New\", 9)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3fe5998f",
   "metadata": {},
   "source": [
    "Database layer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "85353be2",
   "metadata": {},
   "outputs": [],
   "source": [
    "def db_connect():\n",
    "    conn = sqlite3.connect(DB_PATH)\n",
    "    conn.row_factory = sqlite3.Row\n",
    "    return conn\n",
    "\n",
    "def db_init():\n",
    "    conn = db_connect()\n",
    "    c = conn.cursor()\n",
    "    c.execute(\"\"\"CREATE TABLE IF NOT EXISTS students (\n",
    "        id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "        name TEXT NOT NULL,\n",
    "        student_id TEXT NOT NULL UNIQUE,\n",
    "        course TEXT NOT NULL,\n",
    "        year INTEGER NOT NULL\n",
    "    )\"\"\")\n",
    "    c.execute(\"\"\"CREATE TABLE IF NOT EXISTS attendance (\n",
    "        id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "        student_id TEXT NOT NULL,\n",
    "        name TEXT NOT NULL,\n",
    "        date TEXT NOT NULL,\n",
    "        time TEXT NOT NULL,\n",
    "        status TEXT NOT NULL DEFAULT 'Present',\n",
    "        FOREIGN KEY (student_id) REFERENCES students(student_id)\n",
    "    )\"\"\")\n",
    "    conn.commit()\n",
    "    conn.close()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "768effb6",
   "metadata": {},
   "outputs": [],
   "source": [
    "def db_add_student(name, sid, course, year):\n",
    "    try:\n",
    "        conn = db_connect()\n",
    "        conn.execute(\n",
    "            \"INSERT INTO students (name,student_id,course,year) VALUES (?,?,?,?)\",\n",
    "            (name.strip(), sid.strip(), course.strip(), int(year))\n",
    "        )\n",
    "        conn.commit(); conn.close()\n",
    "        return True\n",
    "    except sqlite3.IntegrityError:\n",
    "        return False"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "1e87b9d0",
   "metadata": {},
   "outputs": [],
   "source": [
    "def db_delete_student(sid):\n",
    "    conn = db_connect()\n",
    "    conn.execute(\"DELETE FROM attendance WHERE student_id=?\", (sid,))\n",
    "    conn.execute(\"DELETE FROM students WHERE student_id=?\", (sid,))\n",
    "    conn.commit(); conn.close()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "b2516987",
   "metadata": {},
   "outputs": [],
   "source": [
    "def db_get_students():\n",
    "    conn = db_connect()\n",
    "    rows = [dict(r) for r in conn.execute(\"SELECT * FROM students ORDER BY name\")]\n",
    "    conn.close()\n",
    "    return rows"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "3a059e04",
   "metadata": {},
   "outputs": [],
   "source": [
    "def db_get_student(sid):\n",
    "    conn = db_connect()\n",
    "    row = conn.execute(\"SELECT * FROM students WHERE student_id=?\", (sid,)).fetchone()\n",
    "    conn.close()\n",
    "    return dict(row) if row else None"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "a0ff752e",
   "metadata": {},
   "outputs": [],
   "source": [
    "def db_sid_exists(sid):\n",
    "    return db_get_student(sid) is not None\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "5a1fbf3a",
   "metadata": {},
   "outputs": [],
   "source": [
    "def db_mark_attendance(sid, name):\n",
    "    today = date.today().strftime(\"%Y-%m-%d\")\n",
    "    now   = datetime.now().strftime(\"%H:%M:%S\")\n",
    "    try:\n",
    "        conn = db_connect()\n",
    "        if conn.execute(\"SELECT id FROM attendance WHERE student_id=? AND date=?\",\n",
    "                        (sid, today)).fetchone():\n",
    "            conn.close(); return 'duplicate'\n",
    "        conn.execute(\n",
    "            \"INSERT INTO attendance (student_id,name,date,time,status) VALUES (?,?,?,?,?)\",\n",
    "            (sid, name, today, now, \"Present\")\n",
    "        )\n",
    "        conn.commit(); conn.close()\n",
    "        return 'marked'\n",
    "    except Exception as e:\n",
    "        return 'error'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "adb82443",
   "metadata": {},
   "outputs": [],
   "source": [
    "def db_get_attendance(target_date=None):\n",
    "    if target_date is None:\n",
    "        target_date = date.today().strftime(\"%Y-%m-%d\")\n",
    "    conn = db_connect()\n",
    "    rows = [dict(r) for r in conn.execute(\n",
    "        \"SELECT * FROM attendance WHERE date=? ORDER BY time\", (target_date,))]\n",
    "    conn.close()\n",
    "    return rows\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "42516f21",
   "metadata": {},
   "outputs": [],
   "source": [
    "def db_get_all_attendance():\n",
    "    conn = db_connect()\n",
    "    rows = [dict(r) for r in conn.execute(\n",
    "        \"SELECT * FROM attendance ORDER BY date DESC, time DESC\")]\n",
    "    conn.close()\n",
    "    return rows"
   ]
  },
  {
   "cell_type": "code",
