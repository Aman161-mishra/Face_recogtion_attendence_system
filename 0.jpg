   "source": [
    "TAB 1 — DASHBOARD"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "ff40dbc0",
   "metadata": {},
   "outputs": [],
   "source": [
    "class DashboardTab(tk.Frame):\n",
    "    def __init__(self, parent, app):\n",
    "        super().__init__(parent, bg=BG)\n",
    "        self.app = app\n",
    "        self._build()\n",
    "\n",
    "    def _build(self):\n",
    "        # ── ASCII banner ──────────────────────────────────────────────────────\n",
    "        banner_frame = tk.Frame(self, bg=BG)\n",
    "        banner_frame.pack(fill=\"x\", padx=30, pady=(20,10))\n",
    "\n",
    "        banner = (\n",
    "\"  ██████╗  ███████╗\\n\"\n",
    "\" ██╔════╝  ██╔════╝\\n\"\n",
    "\" ██║  ███╗ ███████╗\\n\"\n",
    "\" ██║   ██║ ╚════██║\\n\"\n",
    "\" ╚██████╔╝ ███████║\\n\"\n",
    "\"  ╚═════╝  ╚══════╝\"\n",
    ")\n",
    "                \n",
    "        tk.Label(banner_frame, text=banner, font=(\"Courier New\", 11, \"bold\"),\n",
    "                 bg=BG, fg=ACCENT, justify=\"left\").pack(side=\"left\")\n",
    "\n",
    "        title_frame = tk.Frame(banner_frame, bg=BG)\n",
    "        title_frame.pack(side=\"left\", padx=20)\n",
    "        tk.Label(title_frame, text=\"Smart Student\\nAttendance System\",\n",
    "                 font=(\"Courier New\", 18, \"bold\"),\n",
    "                 bg=BG, fg=TEXT, justify=\"left\").pack(anchor=\"w\")\n",
    "        tk.Label(title_frame, text=\"Made by using OpenCV · LBPH · SQLite\",\n",
    "                 font=F_MONO, bg=BG, fg=MUTED).pack(anchor=\"w\")\n",
    "        # tk.Label(title_frame, text=\"Made by Gurkirat Singh\",\n",
    "        #          font=F_MONO, bg=BG, fg=MUTED).pack(anchor=\"w\")\n",
    "\n",
    "\n",
    "        tk.Frame(self, height=1, bg=ACCENT).pack(fill=\"x\", padx=30)\n",
    "\n",
    "        # ── Stats row ─────────────────────────────────────────────────────────\n",
    "        stats = tk.Frame(self, bg=BG)\n",
    "        stats.pack(fill=\"x\", padx=30, pady=20)\n",
    "        self._stat_cards = {}\n",
    "        for label, key, color in [\n",
    "            (\"STUDENTS\", \"students\", ACCENT),\n",
    "            (\"TODAY\", \"today\", ACCENT2),\n",
    "            (\"ALL TIME\", \"total\", WARN),\n",
    "            (\"MODEL\", \"model\", \"#c084fc\"),\n",
    "        ]:\n",
    "            c = tk.Frame(stats, bg=CARD, padx=24, pady=18)\n",
    "            c.pack(side=\"left\", fill=\"both\", expand=True, padx=6)\n",
    "            tk.Frame(c, height=3, bg=color).pack(fill=\"x\")\n",
    "            val_lbl = tk.Label(c, text=\"—\", font=(\"Courier New\",28,\"bold\"),\n",
    "                               bg=CARD, fg=color)\n",
    "            val_lbl.pack(pady=(10,2))\n",
    "            tk.Label(c, text=label, font=F_MONO, bg=CARD,\n",
    "                     fg=MUTED).pack()\n",
    "            self._stat_cards[key] = val_lbl\n",
    "\n",
    "        # ── Recent attendance ─────────────────────────────────────────────────\n",
    "        rc = card(self, padx=0, pady=0)\n",
    "        rc.pack(fill=\"both\", expand=True, padx=30, pady=(0,20))\n",
    "        section_label(rc, \"▸ TODAY'S ATTENDANCE\")\n",
    "        self.recent_tree = make_tree(rc,\n",
    "            cols=(\"#\", \"Name\", \"Student ID\", \"Time\", \"Status\"),\n",
    "            widths=[40, 220, 130, 100, 100])\n",
    "\n",
    "        # refresh button\n",
    "        btn_row = tk.Frame(rc, bg=CARD)\n",
    "        btn_row.pack(fill=\"x\", padx=18, pady=(0,12))\n",
    "        styled_btn(btn_row, \"↻  Refresh\", self.refresh).pack(side=\"left\")\n",
    "\n",
    "        self.refresh()\n",
    "\n",
    "    def refresh(self):\n",
    "        students  = db_get_students()\n",
    "        today_att = db_get_attendance()\n",
    "        all_att   = db_get_all_attendance()\n",
    "        model_ok  = os.path.exists(MODEL_FILE)\n",
    "\n",
    "        self._stat_cards[\"students\"].config(text=str(len(students)))\n",
    "        self._stat_cards[\"today\"].config(text=str(len(today_att)))\n",
    "        self._stat_cards[\"total\"].config(text=str(len(all_att)))\n",
    "        self._stat_cards[\"model\"].config(\n",
    "            text=\"READY\" if model_ok else \"NONE\",\n",
    "            fg=ACCENT2 if model_ok else DANGER)\n",
    "\n",
    "        for row in self.recent_tree.get_children():\n",
    "            self.recent_tree.delete(row)\n",
    "        for i, r in enumerate(today_att, 1):\n",
    "            self.recent_tree.insert(\"\", \"end\",\n",
    "                values=(i, r[\"name\"], r[\"student_id\"],\n",
    "                        r[\"time\"], r[\"status\"]))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ea4580ad",
   "metadata": {},
   "source": [
    "TAB 2 — REGISTER STUDENT"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "2c5f06db",
   "metadata": {},
   "outputs": [],
   "source": [
    "class RegisterTab(tk.Frame):\n",
    "    def __init__(self, parent, app):\n",
    "        super().__init__(parent, bg=BG)\n",
    "        self.app = app\n",
    "        self._build()\n",
    "\n",
    "    def _build(self):\n",
    "        panes = tk.PanedWindow(self, orient=\"horizontal\",\n",
    "                               bg=BG, sashwidth=4,\n",
    "                               sashrelief=\"flat\", bd=0)\n",
    "        panes.pack(fill=\"both\", expand=True, padx=16, pady=16)\n",
    "\n",
    "        # ── Left: form ────────────────────────────────────────────────────────\n",
    "        left = card(panes)\n",
    "        panes.add(left, minsize=340)\n",
    "\n",
    "        section_label(left, \"▸ NEW STUDENT\")\n",
    "\n",
    "        self.v_name   = tk.StringVar()\n",
    "        self.v_sid    = tk.StringVar()\n",
    "        self.v_course = tk.StringVar()\n",
    "        self.v_year   = tk.StringVar()\n",
    "\n",
    "        form_row(left, \"Full Name\",   self.v_name)\n",
    "        form_row(left, \"Student ID\",  self.v_sid)\n",
    "        form_row(left, \"Course\",      self.v_course)\n",
    "        form_row(left, \"Year\",  self.v_year)\n",
    "\n",
    "        btn_grid = tk.Frame(left, bg=CARD)\n",
    "        btn_grid.pack(fill=\"x\", padx=18, pady=12)\n",
    "\n",
    "        self.btn_save = styled_btn(btn_grid, \"💾  Save & Capture\",\n",
    "                                   self._on_save, color=ACCENT, fg=BG)\n",
    "        self.btn_save.pack(fill=\"x\", pady=3)\n",
    "\n",
    "        self.btn_train = styled_btn(btn_grid, \"🧠  Retrain Model\",\n",
    "                                    self._on_train, color=\"#1e3a2f\", fg=ACCENT2)\n",
    "        self.btn_train.pack(fill=\"x\", pady=3)\n",
    "\n",
    "        sep(left)\n",
    "        section_label(left, \"▸ STATUS LOG\")\n",
    "        self.log = log_box(left, height=12)\n",
    "\n",
    "        # ── Right: student list ────────────────────────────────────────────────\n",
    "        right = card(panes)\n",
    "        panes.add(right, minsize=340)\n",
    "\n",
    "        section_label(right, \"▸ REGISTERED STUDENTS\")\n",
    "        self.tree = make_tree(right,\n",
    "            cols=(\"Name\", \"ID\", \"Course\", \"Year\"),\n",
    "            widths=[180, 100, 130, 60])\n",
    "\n",
    "        action_row = tk.Frame(right, bg=CARD)\n",
    "        action_row.pack(fill=\"x\", padx=18, pady=(0,12))\n",
    "        styled_btn(action_row, \"🗑  Delete Selected\",\n",
    "                   self._on_delete, color=\"#2a1010\", fg=DANGER).pack(side=\"left\")\n",
    "        styled_btn(action_row, \"↻ Refresh\",\n",
    "                   self._refresh_table, color=PANEL, fg=MUTED).pack(side=\"right\")\n",
    "\n",
    "        self._refresh_table()\n",
    "\n",
    "    def _log(self, msg):\n",
    "        log_write(self.log, msg)\n",
    "\n",
    "    def _log_safe(self, msg):\n",
    "        self.after(0, lambda: self._log(msg))\n",
    "\n",
    "    def _set_btns(self, state):\n",
    "        self.btn_save.config(state=state)\n",
    "        self.btn_train.config(state=state)\n",
    "\n",
    "    def _on_save(self):\n",
    "        name   = self.v_name.get().strip()\n",
    "        sid    = self.v_sid.get().strip()\n",
    "        course = self.v_course.get().strip()\n",
    "        year   = self.v_year.get().strip()\n",
    "\n",
    "        if not all([name, sid, course, year]):\n",
    "            messagebox.showwarning(\"Missing Fields\", \"Fill in all fields.\"); return\n",
    "        if not year.isdigit() or not (1 <= int(year) <=100):\n",
    "            messagebox.showwarning(\"Invalid Year\", \"Year must be 1–6.\"); return\n",
    "        if db_sid_exists(sid):\n",
    "            messagebox.showerror(\"Duplicate ID\", f\"ID '{sid}' already exists.\"); return\n",
    "\n",
    "        if not db_add_student(name, sid, course, year):\n",
    "            messagebox.showerror(\"DB Error\", \"Could not save student.\"); return\n",
    "\n",
    "        self._log(f\"✔ '{name}' saved to database.\")\n",
    "        self._refresh_table()\n",
    "        self.app.dashboard.refresh()\n",
    "\n",
    "        # Clear fields\n",
    "        for v in (self.v_name, self.v_sid, self.v_course, self.v_year):\n",
    "            v.set(\"\")\n",
    "\n",
    "        self._set_btns(\"disabled\")\n",
    "        threading.Thread(target=self._capture_worker,\n",
    "                         args=(sid, name), daemon=True).start()\n",
    "\n",
    "    def _capture_worker(self, sid, name):\n",
    "        self._log_safe(\"📷 Opening webcam …\")\n",
    "        ok = capture_faces(sid, name, self._log_safe)\n",
    "        if ok:\n",
    "            self._log_safe(\"🧠 Training model …\")\n",
    "            train_model(self._log_safe)\n",
    "            self._log_safe(\"✅ Done! Ready for attendance.\")\n",
    "        else:\n",
    "            self._log_safe(\"⚠ Capture incomplete.\")\n",
    "        self.after(0, lambda: self._set_btns(\"normal\"))\n",
    "        self.after(0, self.app.dashboard.refresh)\n",
    "\n",
    "    def _on_train(self):\n",
    "        self._set_btns(\"disabled\")\n",
    "        self._log(\"🧠 Training model …\")\n",
    "        def worker():\n",
    "            train_model(self._log_safe)\n",
    "            self._log_safe(\"✅ Training complete!\")\n",
    "            self.after(0, lambda: self._set_btns(\"normal\"))\n",
    "            self.after(0, self.app.dashboard.refresh)\n",
    "        threading.Thread(target=worker, daemon=True).start()\n",
    "\n",
    "    def _on_delete(self):\n",
    "        sel = self.tree.selection()\n",
    "        if not sel:\n",
    "            messagebox.showwarning(\"Select Student\",\n",
    "                                   \"Click a student in the list first.\"); return\n",
    "        vals = self.tree.item(sel[0])[\"values\"]\n",
    "        sid  = str(vals[1])\n",
    "        name = vals[0]\n",
    "        if not messagebox.askyesno(\"Confirm Delete\",\n",
    "            f\"Delete '{name}' (ID: {sid})?\\n\\n\"\n",
    "            \"This removes their DB records, attendance history,\\n\"\n",
    "            \"and face images. This cannot be undone.\"):\n",
    "            return\n",
    "\n",
    "        db_delete_student(sid)\n",
    "\n",
    "        # Remove dataset folder\n",
    "        folder = os.path.join(DATASET_DIR, sid)\n",
    "        if os.path.exists(folder):\n",
    "            shutil.rmtree(folder)\n",
    "            self._log(f\"🗑 Removed dataset/{sid}/\")\n",
    "\n",
    "        self._log(f\"✔ Student '{name}' deleted.\")\n",
    "        self._log(\"🧠 Retraining model …\")\n",
    "        self._set_btns(\"disabled\")\n",
    "\n",
    "        def worker():\n",
    "            train_model(self._log_safe)\n",
    "            self._log_safe(\"✅ Retrained after deletion.\")\n",
    "            self.after(0, lambda: self._set_btns(\"normal\"))\n",
    "            self.after(0, self._refresh_table)\n",
    "            self.after(0, self.app.dashboard.refresh)\n",
    "        threading.Thread(target=worker, daemon=True).start()\n",
    "\n",
    "    def _refresh_table(self):\n",
    "        for row in self.tree.get_children():\n",
    "            self.tree.delete(row)\n",
    "        for s in db_get_students():\n",
    "            self.tree.insert(\"\", \"end\",\n",
    "                values=(s[\"name\"], s[\"student_id\"],\n",
    "                        s[\"course\"], s[\"year\"]))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a3ecc571",
   "metadata": {},
   "source": [
    "TAB 3 — LIVE ATTENDANCE     "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "b917b1ba",
   "metadata": {},
   "outputs": [],
   "source": [
    "class AttendanceTab(tk.Frame):\n",
    "    def __init__(self, parent, app):\n",
    "        super().__init__(parent, bg=BG)\n",
    "        self.app = app\n",
    "        self._running = False\n",
    "        self._build()\n",
    "\n",
    "    def _build(self):\n",
    "        top = card(self)\n",
    "        top.pack(fill=\"x\", padx=16, pady=(16,8))\n",
    "        section_label(top, \"▸ LIVE FACE RECOGNITION\")\n",
    "\n",
    "        ctrl = tk.Frame(top, bg=CARD)\n",
    "        ctrl.pack(fill=\"x\", padx=18, pady=(0,14))\n",
    "\n",
    "        self.btn_start = styled_btn(ctrl, \"▶  Start Camera\",\n",
    "                                    self._start, color=ACCENT2, fg=BG)\n",
    "        self.btn_start.pack(side=\"left\", padx=(0,8))\n",
    "\n",
    "        self.btn_stop = styled_btn(ctrl, \"■  Stop\",\n",
    "                                   self._stop, color=DANGER, fg=\"white\")\n",
    "        self.btn_stop.pack(side=\"left\")\n",
    "        self.btn_stop.config(state=\"disabled\")\n",
    "\n",
    "        # Settings\n",
    "        sf = tk.Frame(ctrl, bg=CARD)\n",
    "        sf.pack(side=\"right\")\n",
    "        tk.Label(sf, text=\"Confidence ≤\", font=F_LABEL,\n",
    "                 bg=CARD, fg=MUTED).pack(side=\"left\")\n",
    "        self.conf_var = tk.IntVar(value=CONFIDENCE_THRESHOLD)\n",
    "        tk.Spinbox(sf, from_=30, to=100, textvariable=self.conf_var,\n",
    "                   width=4, font=F_ENTRY, bg=ENTRY_BG, fg=ACCENT,\n",
    "                   buttonbackground=PANEL, relief=\"flat\").pack(side=\"left\", padx=4)\n",
    "        tk.Label(sf, text=\"  Smile frames:\", font=F_LABEL,\n",
    "                 bg=CARD, fg=MUTED).pack(side=\"left\")\n",
    "        self.smile_var = tk.IntVar(value=SMILE_CONFIRM_FRAMES)\n",
    "        tk.Spinbox(sf, from_=1, to=20, textvariable=self.smile_var,\n",
    "                   width=3, font=F_ENTRY, bg=ENTRY_BG, fg=ACCENT,\n",
    "                   buttonbackground=PANEL, relief=\"flat\").pack(side=\"left\")\n",
    "\n",
    "        # Status\n",
    "        status_card = card(self)\n",
    "        status_card.pack(fill=\"x\", padx=16, pady=(0,8))\n",
    "        section_label(status_card, \"▸ SESSION STATUS\")\n",
    "\n",
    "        self.status_lbl = tk.Label(status_card,\n",
    "            text=\"Camera stopped. Press ▶ Start Camera to begin.\",\n",
    "            font=(\"Courier New\", 11), bg=CARD, fg=MUTED,\n",
    "            pady=10)\n",
    "        self.status_lbl.pack(padx=18, anchor=\"w\")\n",
    "\n",
    "        # Session log\n",
    "        log_card = card(self)\n",
    "        log_card.pack(fill=\"both\", expand=True, padx=16, pady=(0,16))\n",
    "        section_label(log_card, \"▸ SESSION LOG\")\n",
    "        self.log = log_box(log_card, height=14)\n",
    "\n",
    "    def _log(self, msg):\n",
    "        log_write(self.log, msg)\n",
    "\n",
    "    def _log_safe(self, msg):\n",
    "        self.after(0, lambda: self._log(msg))\n",
    "\n",
    "    def _set_status(self, msg, color=TEXT):\n",
    "        self.after(0, lambda: self.status_lbl.config(text=msg, fg=color))\n",
    "\n",
    "    def _start(self):\n",
    "        rec, lmap = load_recognizer()\n",
    "        if rec is None:\n",
    "            messagebox.showerror(\"No Model\",\n",
    "                \"Trained model not found.\\nGo to Register tab and click Retrain Model.\")\n",
    "            return\n",
    "        self._running = True\n",
    "        self.btn_start.config(state=\"disabled\")\n",
    "        self.btn_stop.config(state=\"normal\")\n",
    "        self._log(\"▶ Session started.\")\n",
    "        threading.Thread(target=self._camera_loop,\n",
    "                         args=(rec, lmap), daemon=True).start()\n",
    "\n",
    "    def _stop(self):\n",
    "        self._running = False\n",
    "        self.btn_start.config(state=\"normal\")\n",
    "        self.btn_stop.config(state=\"disabled\")\n",
    "        self._set_status(\"Camera stopped.\", MUTED)\n",
    "\n",
    "    def _camera_loop(self, rec, lmap):\n",
    "        conf_thresh   = self.conf_var.get()\n",
    "        smile_thresh  = self.smile_var.get()\n",
    "        session_state = {}\n",
    "        flash_msg, flash_until = \"\", 0\n",
    "\n",
    "        cap = cv2.VideoCapture(0)\n",
    "        if not cap.isOpened():\n",
    "            self._log_safe(\"[ERR] Cannot open webcam.\")\n",
    "            self.after(0, self._stop); return\n",
    "\n",
    "        self._set_status(\"● Camera active — look at the camera.\", ACCENT2)\n",
    "\n",
    "        while self._running:\n",
    "            ret, frame = cap.read()\n",
    "            if not ret: break\n",
    "\n",
    "            frame = cv2.flip(frame, 1)\n",
    "            gray  = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n",
    "            h, w  = frame.shape[:2]\n",
    "\n",
    "            # Header bar\n",
    "            ov = frame.copy()\n",
    "            cv2.rectangle(ov, (0,0),(w,52),(8,12,20),-1)\n",
    "            cv2.addWeighted(ov, 0.8, frame, 0.2, 0, frame)\n",
    "            cv2.putText(frame, \"SMART ATTENDANCE SYSTEM\",\n",
    "                        (12,34), cv2.FONT_HERSHEY_SIMPLEX,\n",
    "                        0.75, (0,200,255), 2, cv2.LINE_AA)\n",
    "            ts = datetime.now().strftime(\"%H:%M:%S  %d/%m/%Y\")\n",
    "            cv2.putText(frame, ts, (w-260,34),\n",
    "                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (100,180,255), 1)\n",
    "\n",
    "            faces = FACE_CASCADE.detectMultiScale(\n",
    "                gray, 1.3, 5, minSize=(80,80))\n",
    "\n",
    "            detected_names = []\n",
    "\n",
    "            for (x, y, fw, fh) in faces:\n",
    "                roi_gray  = gray[y:y+fh, x:x+fw]\n",
    "                roi_color = frame[y:y+fh, x:x+fw]\n",
    "\n",
    "                label, conf = rec.predict(cv2.resize(roi_gray,(200,200)))\n",
    "                known = conf < conf_thresh\n",
    "                sid   = lmap.get(label) if known else None\n",
    "                stu   = db_get_student(sid) if sid else None\n",
    "\n",
    "                if known and stu:\n",
    "                    dname  = stu[\"name\"]\n",
    "                    pct    = int(100 - conf)\n",
    "                    bcolor = (0,200,130)\n",
    "                    detected_names.append(f\"{dname} ({pct}%)\")\n",
    "                else:\n",
    "                    dname, pct, bcolor = \"Unknown\", 0, (60,60,200)\n",
    "\n",
    "                # Face box\n",
    "                cv2.rectangle(frame,(x,y),(x+fw,y+fh),bcolor,2)\n",
    "                tag = f\"{dname}  {pct}%\" if known else \"Unknown\"\n",
    "                cv2.rectangle(frame,(x,y-28),(x+fw,y),(8,12,20),-1)\n",
    "                cv2.putText(frame, tag, (x+4, y-8),\n",
    "                            cv2.FONT_HERSHEY_SIMPLEX, 0.6, bcolor, 2)\n",
    "\n",
    "                if known and stu:\n",
    "                    s = stu[\"student_id\"]\n",
    "                    if s not in session_state:\n",
    "                        session_state[s] = {\"smile_frames\":0,\"marked\":False}\n",
    "                    state = session_state[s]\n",
    "\n",
    "                    if state[\"marked\"]:\n",
    "                        cv2.putText(frame, \"✔ MARKED\", (x, y+fh+22),\n",
    "                                    cv2.FONT_HERSHEY_SIMPLEX, 0.6,\n",
    "                                    (0,220,130), 2)\n",
    "                    else:\n",
    "                        smiles = SMILE_CASCADE.detectMultiScale(\n",
    "                            roi_gray, 1.8, 20, minSize=(25,25))\n",
    "                        if len(smiles):\n",
    "                            state[\"smile_frames\"] += 1\n",
    "                            sx,sy,sw,sh = smiles[0]\n",
    "                            cv2.rectangle(roi_color,\n",
    "                                          (sx,sy),(sx+sw,sy+sh),(0,255,180),2)\n",
    "                            left_cnt = smile_thresh - state[\"smile_frames\"]\n",
    "                            msg = f\"SMILE {max(0,left_cnt)} more\"\n",
    "                            cv2.putText(frame, msg, (x, y+fh+22),\n",
    "                                        cv2.FONT_HERSHEY_SIMPLEX,\n",
    "                                        0.6, (0,255,180), 2)\n",
    "                        else:\n",
    "                            state[\"smile_frames\"] = max(0, state[\"smile_frames\"]-1)\n",
    "                            cv2.putText(frame, \"Smile to mark attendance\",\n",
    "                                        (x, y+fh+22),\n",
    "                                        cv2.FONT_HERSHEY_SIMPLEX,\n",
    "                                        0.55, (200,200,80), 1)\n",
    "\n",
    "                        if state[\"smile_frames\"] >= smile_thresh:\n",
    "                            result = db_mark_attendance(s, stu[\"name\"])\n",
    "                            state[\"marked\"] = True\n",
    "                            state[\"smile_frames\"] = 0\n",
    "                            if result == 'marked':\n",
    "                                m = f\"✔ Attendance marked: {stu['name']}\"\n",
    "                                self._log_safe(m)\n",
    "                                self._set_status(m, ACCENT2)\n",
    "                                self.after(0, self.app.dashboard.refresh)\n",
    "                            elif result == 'duplicate':\n",
    "                                m = f\"Already marked today: {stu['name']}\"\n",
    "                                self._log_safe(m)\n",
    "                            flash_msg, flash_until = m, time.time()+4\n",
    "\n",
    "            if detected_names:\n",
    "                self._set_status(\"Detected: \" + \", \".join(detected_names), ACCENT)\n",
    "            elif not faces.size if hasattr(faces,'size') else len(faces)==0:\n",
    "                self._set_status(\"● No face detected …\", MUTED)\n",
    "\n",
    "            # Flash banner\n",
    "            if time.time() < flash_until:\n",
    "                tw,_ = cv2.getTextSize(flash_msg,cv2.FONT_HERSHEY_SIMPLEX,0.75,2)[0]\n",
    "                bx = (w-tw)//2-10; by = h-55\n",
    "                cv2.rectangle(frame,(bx,by-30),(bx+tw+20,by+8),(10,35,20),-1)\n",
    "                cv2.putText(frame, flash_msg, (bx+10,by),\n",
    "                            cv2.FONT_HERSHEY_SIMPLEX, 0.75, (80,240,130), 2)\n",
    "\n",
    "            cv2.putText(frame, \"Press Q to stop\", (12, h-12),\n",
    "                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (60,90,110), 1)\n",
    "            cv2.imshow(\"Smart Attendance System\", frame)\n",
    "            if cv2.waitKey(1) & 0xFF == ord('q'):\n",
    "                break\n",
    "\n",
    "        cap.release()\n",
    "        cv2.destroyAllWindows()\n",
    "        self._running = False\n",
    "        self.after(0, self._stop)\n",
    "        self._log_safe(\"■ Session ended.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "da317982",
   "metadata": {},
   "source": [
    "TAB 4 — ATTENDANCE RECORDS  "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "4519f9a0",
   "metadata": {},
   "outputs": [],
   "source": [
    "class RecordsTab(tk.Frame):\n",
    "    def __init__(self, parent, app):\n",
    "        super().__init__(parent, bg=BG)\n",
    "        self.app = app\n",
    "        self._build()\n",
    "\n",
    "    def _build(self):\n",
    "        top = card(self)\n",
    "        top.pack(fill=\"x\", padx=16, pady=(16,8))\n",
    "        section_label(top, \"▸ ATTENDANCE RECORDS\")\n",
    "\n",
    "        ctrl = tk.Frame(top, bg=CARD)\n",
    "        ctrl.pack(fill=\"x\", padx=18, pady=(0,14))\n",
    "\n",
    "        tk.Label(ctrl, text=\"Date:\", font=F_LABEL,\n",
    "                 bg=CARD, fg=MUTED).pack(side=\"left\")\n",
    "        self.date_var = tk.StringVar(value=date.today().strftime(\"%Y-%m-%d\"))\n",
    "        tk.Entry(ctrl, textvariable=self.date_var, font=F_ENTRY,\n",
    "                 bg=ENTRY_BG, fg=TEXT, insertbackground=ACCENT,\n",
    "                 relief=\"flat\", bd=6, width=14).pack(side=\"left\", padx=8)\n",
    "\n",
    "        styled_btn(ctrl, \"Filter\", self._filter,\n",
    "                   color=ACCENT, fg=BG).pack(side=\"left\", padx=4)\n",
    "        styled_btn(ctrl, \"All Records\", self._load_all,\n",
    "                   color=PANEL, fg=TEXT).pack(side=\"left\", padx=4)\n",
    "        styled_btn(ctrl, \"Today\", self._load_today,\n",
    "                   color=PANEL, fg=TEXT).pack(side=\"left\", padx=4)\n",
    "        styled_btn(ctrl, \"Export CSV\", self._export,\n",
    "                   color=\"#1e3a2f\", fg=ACCENT2).pack(side=\"right\")\n",
    "\n",
    "        self.count_lbl = tk.Label(top, text=\"\", font=F_MONO,\n",
    "                                  bg=CARD, fg=MUTED)\n",
    "        self.count_lbl.pack(padx=18, anchor=\"w\", pady=(0,8))\n",
    "\n",
    "        # Table\n",
    "        tcard = card(self)\n",
    "        tcard.pack(fill=\"both\", expand=True, padx=16, pady=(0,16))\n",
    "        self.tree = make_tree(tcard,\n",
    "            cols=(\"#\", \"Name\", \"Student ID\", \"Date\", \"Time\", \"Status\"),\n",
    "            widths=[40, 210, 120, 110, 90, 90])\n",
    "\n",
    "        # Delete attendance row\n",
    "        del_row = tk.Frame(tcard, bg=CARD)\n",
    "        del_row.pack(fill=\"x\", padx=18, pady=(0,12))\n",
    "        styled_btn(del_row, \"🗑  Delete Selected Row\",\n",
    "                   self._delete_row, color=\"#2a1010\", fg=DANGER).pack(side=\"left\")\n",
    "\n",
    "        self._load_today()\n",
    "\n",
    "    def _populate(self, rows):\n",
    "        for r in self.tree.get_children():\n",
    "            self.tree.delete(r)\n",
    "        for i, r in enumerate(rows, 1):\n",
    "            self.tree.insert(\"\", \"end\",\n",
    "                values=(i, r[\"name\"], r[\"student_id\"],\n",
    "                        r[\"date\"], r[\"time\"], r[\"status\"]))\n",
    "        self.count_lbl.config(text=f\"{len(rows)} record(s)\")\n",
    "\n",
    "    def _load_today(self):\n",
    "        self.date_var.set(date.today().strftime(\"%Y-%m-%d\"))\n",
    "        self._populate(db_get_attendance())\n",
    "\n",
    "    def _load_all(self):   self._populate(db_get_all_attendance())\n",
    "    def _filter(self):     self._populate(db_get_attendance(self.date_var.get().strip()))\n",
    "\n",
    "    def _delete_row(self):\n",
    "        sel = self.tree.selection()\n",
    "        if not sel:\n",
    "            messagebox.showwarning(\"Select Row\",\n",
    "                                   \"Click an attendance record first.\"); return\n",
    "        vals = self.tree.item(sel[0])[\"values\"]\n",
    "        sid, date_str = str(vals[2]), str(vals[3])\n",
    "        if not messagebox.askyesno(\"Confirm\",\n",
    "            f\"Delete attendance record for ID '{sid}' on {date_str}?\"): return\n",
    "        conn = sqlite3.connect(DB_PATH)\n",
    "        conn.execute(\"DELETE FROM attendance WHERE student_id=? AND date=?\",\n",
    "                     (sid, date_str))\n",
    "        conn.commit(); conn.close()\n",
    "        self._load_all()\n",
    "        self.app.dashboard.refresh()\n",
    "\n",
    "    def _export(self):\n",
    "        path = filedialog.asksaveasfilename(\n",
    "            defaultextension=\".csv\",\n",
    "            filetypes=[(\"CSV files\",\"*.csv\")],\n",
    "            title=\"Save Attendance CSV\")\n",
    "        if not path: return\n",
    "        rows = [self.tree.item(r)[\"values\"] for r in self.tree.get_children()]\n",
    "        with open(path, \"w\", newline=\"\") as f:\n",
    "            w = csv.writer(f)\n",
    "            w.writerow([\"#\",\"Name\",\"Student ID\",\"Date\",\"Time\",\"Status\"])\n",
    "            w.writerows(rows)\n",
    "        messagebox.showinfo(\"Exported\", f\"Saved to:\\n{path}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f585b713",
   "metadata": {},
   "source": [
    " MAIN APPLICATION WINDOW "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "c2fe19e4",
   "metadata": {},
   "outputs": [],
   "source": [
    "class SmartAttendanceApp:\n",
    "    def __init__(self):\n",
    "        db_init()\n",
    "\n",
    "        self.root = tk.Tk()\n",
    "        self.root.title(\"Smart Student Attendance System\")\n",
    "        self.root.geometry(\"1060x720\")\n",
    "        self.root.minsize(900, 600)\n",
    "        self.root.configure(bg=BG)\n",
    "\n",
    "        # Try to set a window icon (skip if unavailable)\n",
    "        try:\n",
    "            self.root.iconbitmap(default=\"\")\n",
    "        except Exception:\n",
    "            pass\n",
    "\n",
    "        self._build_sidebar()\n",
    "        self._build_content()\n",
    "        self._show_tab(0)\n",
    "\n",
    "    def _build_sidebar(self):\n",
    "        \"\"\"Left sidebar with navigation buttons.\"\"\"\n",
    "        self.sidebar = tk.Frame(self.root, bg=PANEL, width=200)\n",
    "        self.sidebar.pack(side=\"left\", fill=\"y\")\n",
    "        self.sidebar.pack_propagate(False)\n",
    "\n",
    "        # Logo area\n",
    "        logo = tk.Frame(self.sidebar, bg=PANEL, pady=20)\n",
    "        logo.pack(fill=\"x\")\n",
    "        tk.Label(logo, text=\"[Smart Attendance System]\", font=(\"Courier New\",10, \"bold\"),\n",
    "                 bg=PANEL, fg=ACCENT).pack()\n",
    "        tk.Label(logo, text=\"Attendance System\",\n",
    "                 font=F_MONO, bg=PANEL, fg=MUTED).pack()\n",
    "\n",
    "        tk.Frame(self.sidebar, height=1, bg=BORDER).pack(fill=\"x\")\n",
    "\n",
    "        # Nav items\n",
    "        self._nav_btns = []\n",
    "        nav_items = [\n",
    "            (\"Dashboard\",  \"📊\"),\n",
    "            (\"Register\",   \"➕\"),\n",
    "            (\"Attendance\", \"📷\"),\n",
    "            (\"Records\",    \"📋\"),\n",
    "        ]\n",
    "        nav_frame = tk.Frame(self.sidebar, bg=PANEL)\n",
    "        nav_frame.pack(fill=\"x\", pady=12)\n",
    "\n",
    "        for i, (label, icon) in enumerate(nav_items):\n",
    "            btn = tk.Button(\n",
    "                nav_frame,\n",
    "                text=f\"  {icon}  {label}\",\n",
    "                font=F_BTN, anchor=\"w\",\n",
    "                bg=PANEL, fg=MUTED,\n",
    "                activebackground=SEL, activeforeground=ACCENT,\n",
    "                relief=\"flat\", cursor=\"hand2\",\n",
    "                padx=14, pady=11, bd=0,\n",
    "                command=lambda idx=i: self._show_tab(idx)\n",
    "            )\n",
    "            btn.pack(fill=\"x\")\n",
    "            self._nav_btns.append(btn)\n",
    "\n",
    "        # Bottom: version info\n",
    "        tk.Frame(self.sidebar, height=1, bg=BORDER).pack(fill=\"x\", side=\"bottom\", pady=0)\n",
    "        tk.Label(self.sidebar, text=\"Made by Gurkirat Singh\",\n",
    "                 font=F_MONO, bg=PANEL, fg=MUTED,\n",
    "                 pady=10).pack(side=\"bottom\")\n",
    "\n",
    "    def _build_content(self):\n",
    "        \"\"\"Right content area with tabs.\"\"\"\n",
    "        self.content = tk.Frame(self.root, bg=BG)\n",
    "        self.content.pack(side=\"left\", fill=\"both\", expand=True)\n",
    "\n",
    "        self.dashboard  = DashboardTab(self.content, self)\n",
    "        self.register   = RegisterTab(self.content, self)\n",
    "        self.attendance = AttendanceTab(self.content, self)\n",
    "        self.records    = RecordsTab(self.content, self)\n",
    "\n",
    "        self._tabs = [self.dashboard, self.register,\n",
    "                      self.attendance, self.records]\n",
    "\n",
    "    def _show_tab(self, index):\n",
    "        for tab in self._tabs:\n",
    "            tab.pack_forget()\n",
    "        self._tabs[index].pack(fill=\"both\", expand=True)\n",
    "\n",
    "        for i, btn in enumerate(self._nav_btns):\n",
    "            if i == index:\n",
    "                btn.config(bg=SEL, fg=ACCENT)\n",
    "            else:\n",
    "                btn.config(bg=PANEL, fg=MUTED)\n",
    "\n",
    "        # Refresh dashboard when switching to it\n",
    "        if index == 0:\n",
    "            self.dashboard.refresh()\n",
    "        if index == 3:\n",
    "            self.records._load_today()\n",
    "\n",
    "    def run(self):\n",
    "        self.root.mainloop()"
   ]
  },
