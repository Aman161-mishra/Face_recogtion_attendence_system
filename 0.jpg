   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "e3e1e562",
   "metadata": {},
   "outputs": [],
   "source": [
    "def log_write(box, msg):\n",
    "    box.configure(state=\"normal\")\n",
    "    ts = datetime.now().strftime(\"%H:%M:%S\")\n",
    "    box.insert(\"end\", f\"[{ts}] {msg}\\n\")\n",
    "    box.see(\"end\")\n",
    "    box.configure(state=\"disabled\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "cf631595",
   "metadata": {},
   "outputs": [],
   "source": [
    "def make_tree(parent, cols, widths):\n",
    "    style = ttk.Style()\n",
    "    style.theme_use(\"clam\")\n",
    "    style.configure(\"App.Treeview\",\n",
    "                    background=ENTRY_BG, fieldbackground=ENTRY_BG,\n",
    "                    foreground=TEXT, rowheight=28, font=F_TABLE,\n",
    "                    borderwidth=0)\n",
    "    style.configure(\"App.Treeview.Heading\",\n",
    "                    background=PANEL, foreground=ACCENT,\n",
    "                    font=(\"Courier New\", 10, \"bold\"), relief=\"flat\")\n",
    "    style.map(\"App.Treeview\",\n",
    "              background=[(\"selected\", SEL)],\n",
    "              foreground=[(\"selected\", ACCENT)])\n",
    "\n",
    "    frame = tk.Frame(parent, bg=PANEL)\n",
    "    frame.pack(fill=\"both\", expand=True, padx=18, pady=(0,12))\n",
    "\n",
    "    tree = ttk.Treeview(frame, columns=cols, show=\"headings\",\n",
    "                        style=\"App.Treeview\")\n",
    "    for col, w in zip(cols, widths):\n",
    "        tree.heading(col, text=col)\n",
    "        tree.column(col, width=w, anchor=\"center\", minwidth=40)\n",
    "\n",
    "    sb = ttk.Scrollbar(frame, orient=\"vertical\", command=tree.yview)\n",
    "    tree.configure(yscrollcommand=sb.set)\n",
    "    tree.pack(side=\"left\", fill=\"both\", expand=True)\n",
    "    sb.pack(side=\"right\", fill=\"y\")\n",
    "    return tree"
   ]
  },
  {
   "cell_type": "markdown",
