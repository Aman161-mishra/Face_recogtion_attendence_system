   "outputs": [],
   "source": [
    "def db_delete_attendance(sid):\n",
    "    conn = db_connect()\n",
    "    conn.execute(\"DELETE FROM attendance WHERE student_id=?\", (sid,))\n",
    "    conn.commit(); conn.close()"
   ]
