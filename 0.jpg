  {
   "cell_type": "markdown",
   "id": "fd6d90ba",
   "metadata": {},
   "source": [
    " FACE RECOGNITION ENGINE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "0e5163be",
   "metadata": {},
   "outputs": [],
   "source": [
    "FACE_CASCADE  = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_frontalface_default.xml')\n",
    "SMILE_CASCADE = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_smile.xml')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "f2e9f591",
   "metadata": {},
   "outputs": [],
   "source": [
    "def capture_faces(sid, name, log_cb):\n",
    "    \"\"\"Capture IMAGES_TO_SAVE grayscale face images for a student.\"\"\"\n",
    "    folder = os.path.join(DATASET_DIR, sid)\n",
    "    os.makedirs(folder, exist_ok=True)\n",
    "    cap = cv2.VideoCapture(0)\n",
    "    if not cap.isOpened():\n",
    "        log_cb(\"[ERR] Cannot open webcam.\")\n",
    "        return False\n",
    "    saved, last = 0, 0\n",
    "    while saved < IMAGES_TO_SAVE:\n",
    "        ret, frame = cap.read()\n",
    "        if not ret: break\n",
    "        gray  = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n",
    "        faces = FACE_CASCADE.detectMultiScale(gray, 1.3, 5)\n",
    "        for (x, y, w, h) in faces:\n",
    "            cv2.rectangle(frame, (x,y),(x+w,y+h),(0,200,255),2)\n",
    "            now = time.time()\n",
    "            if now - last >= CAPTURE_DELAY:\n",
    "                img = cv2.resize(gray[y:y+h, x:x+w], (200,200))\n",
    "                cv2.imwrite(os.path.join(folder, f\"{saved}.jpg\"), img)\n",
    "                saved += 1; last = now\n",
    "                log_cb(f\"[CAM] {saved}/{IMAGES_TO_SAVE} captured\")\n",
    "            break\n",
    "        cv2.putText(frame, f\"Capturing: {saved}/{IMAGES_TO_SAVE}\", (10,30),\n",
    "                    cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0,200,255), 2)\n",
    "        cv2.putText(frame, f\"Student: {name}\", (10,65),\n",
    "                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255,255,255), 2)\n",
    "        cv2.putText(frame, \"Press Q to cancel\", (10, frame.shape[0]-15),\n",
    "                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (100,100,255), 1)\n",
    "        cv2.imshow(\"Face Capture\", frame)\n",
    "        if cv2.waitKey(1) & 0xFF == ord('q'): break\n",
    "    cap.release(); cv2.destroyAllWindows()\n",
    "    return saved >= IMAGES_TO_SAVE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "aa0d41f1",
   "metadata": {},
   "outputs": [],
   "source": [
    "def train_model(log_cb):\n",
    "    \"\"\"Train LBPH recognizer on dataset/ and save model files.\"\"\"\n",
    "    faces, labels, label_map, idx = [], [], {}, 0\n",
    "    if not os.path.exists(DATASET_DIR):\n",
    "        log_cb(\"[ERR] No dataset folder found.\"); return False\n",
    "    for sid in sorted(os.listdir(DATASET_DIR)):\n",
    "        path = os.path.join(DATASET_DIR, sid)\n",
    "        if not os.path.isdir(path): continue\n",
    "        label_map[idx] = sid; count = 0\n",
    "        for f in os.listdir(path):\n",
    "            img = cv2.imread(os.path.join(path, f), cv2.IMREAD_GRAYSCALE)\n",
    "            if img is None: continue\n",
    "            faces.append(cv2.resize(img,(200,200)))\n",
    "            labels.append(idx); count += 1\n",
    "        log_cb(f\"[TRAIN] {sid}: {count} images (label {idx})\")\n",
    "        idx += 1\n",
    "    if not faces:\n",
    "        log_cb(\"[ERR] No training images found.\"); return False\n",
    "    log_cb(f\"[TRAIN] Total: {len(faces)} images, {len(label_map)} students\")\n",
    "    rec = cv2.face.LBPHFaceRecognizer_create()\n",
    "    rec.train(faces, np.array(labels))\n",
    "    rec.save(MODEL_FILE)\n",
    "    np.save(LABEL_FILE, label_map)\n",
    "    log_cb(f\"[TRAIN] ✔ Model saved → {MODEL_FILE}\")\n",
    "    return True"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "ed66b594",
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_recognizer():\n",
    "    \"\"\"Load trained model. Returns (recognizer, label_map) or (None, None).\"\"\"\n",
    "    if not os.path.exists(MODEL_FILE) or not os.path.exists(LABEL_FILE):\n",
    "        return None, None\n",
    "    rec = cv2.face.LBPHFaceRecognizer_create()\n",
    "    rec.read(MODEL_FILE)\n",
    "    lmap = np.load(LABEL_FILE, allow_pickle=True).item()\n",
    "    return rec, lmap\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ea5be666",
   "metadata": {},
   "source": [
    "WIDGET HELPERS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "6cc4fdeb",
   "metadata": {},
   "outputs": [],
   "source": [
    "def styled_btn(parent, text, cmd, color=ACCENT, fg=BG, width=None):\n",
    "    kw = dict(text=text, command=cmd, font=F_BTN,\n",
    "              bg=color, fg=fg, activebackground=color,\n",
    "              activeforeground=fg, relief=\"flat\",\n",
    "              cursor=\"hand2\", padx=12, pady=7, bd=0)\n",
    "    if width: kw[\"width\"] = width\n",
    "    b = tk.Button(parent, **kw)\n",
    "    # Hover effect\n",
    "    b.bind(\"<Enter>\", lambda e: b.config(bg=_brighten(color)))\n",
    "    b.bind(\"<Leave>\", lambda e: b.config(bg=color))\n",
    "    return b"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "ef6b4125",
   "metadata": {},
   "outputs": [],
   "source": [
    "def _brighten(hex_color):\n",
    "    \"\"\"Return a slightly lighter hex colour for hover states.\"\"\"\n",
    "    h = hex_color.lstrip(\"#\")\n",
    "    r,g,b = int(h[0:2],16), int(h[2:4],16), int(h[4:6],16)\n",
    "    r,g,b = min(255,r+30), min(255,g+30), min(255,b+30)\n",
    "    return f\"#{r:02x}{g:02x}{b:02x}\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "62880357",
   "metadata": {},
   "outputs": [],
   "source": [
