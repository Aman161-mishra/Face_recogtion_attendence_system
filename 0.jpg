   "metadata": {},
   "outputs": [],
   "source": [
    "def log_box(parent, height=8):\n",
    "    box = tk.Text(parent, height=height, font=F_MONO,\n",
    "                  bg=ENTRY_BG, fg=ACCENT2, insertbackground=TEXT,\n",
    "                  relief=\"flat\", state=\"disabled\", wrap=\"word\",\n",
    "                  bd=0, highlightthickness=1,\n",
    "                  highlightbackground=BORDER)\n",
    "    box.pack(fill=\"x\", padx=18, pady=(0,12))\n",
